/target/
**/*.rs.bk
.DS_Store

# Native SimpleX libraries (downloaded or built locally)
/third_party/libsimplex/**
!/third_party/libsimplex/.gitkeep

# Downloaded UI fonts (./scripts/fetch-fonts.sh)
/linux/assets/fonts/**
!/linux/assets/fonts/.gitkeep

# Local IDE / env
.env
.idea/
.vscode/

# Local bug / layout checklist (not tracked)
.bugs.txt
.bug.txt

# Flatpak builds
build-dir/
.flatpak-builder/
repo/
*.flatpak

# macOS app builds (./macos/build.sh)
/macos/build/
/macos/Cursus/.build/
/macos/Cursus/.swiftpm/

# Android build output (also ignored here so branches without android/ never pick it up)
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/jniLibs/
